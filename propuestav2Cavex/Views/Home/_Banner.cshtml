<!-- VERSIÓN A: Fondo Oscuro Espectacular (Texto Izquierda - Tamaño Banner Compacto) -->
<section class="reveal relative w-[95%] max-w-[1100px] mx-auto min-h-[320px] lg:min-h-[360px] rounded-[24px] lg:rounded-[30px] overflow-hidden mt-8 mb-8 flex items-center shadow-[0_15px_40px_-12px_rgba(0,0,0,0.4)] group" style="--reveal-dist: 10px;">
    <!-- Imagen de fondo -->
    <img src="https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?q=80&w=2070&auto=format&fit=crop" 
         alt="Fondo de coche premium" 
         class="absolute inset-0 w-full h-full object-cover grayscale object-right transition-transform duration-[10s] group-hover:scale-105">
    
    <!-- Gradiente / Overlay (Oscuro a la izquierda) -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/95 via-black/85 to-black/5"></div>

    <!-- Contenido -->
    <div class="relative z-10 w-full px-5 py-8 lg:px-10 lg:py-10 flex flex-col lg:flex-row items-center">
        <!-- Columna de Texto -->
        <div class="lg:w-[75%] space-y-4 lg:space-y-5">
            <h1 class="text-3xl lg:text-4xl xl:text-[2.6rem] font-black leading-[1.1] tracking-tighter text-white uppercase">
                Traslados <span class="text-transparent bg-clip-text bg-gradient-to-r from-gray-400 to-white">Seguros y Programados</span><br>
                Para tus destinos importantes.
            </h1>
            
            <div class="bg-black/30 backdrop-blur-md border border-white/10 p-4 rounded-2xl max-w-[32rem] shadow-xl transition-all duration-500 hover:bg-black/40">
                <p class="text-sm lg:text-[15px] text-gray-300 font-medium leading-relaxed">
                    Grupo <span class="text-white font-bold">CAVEX</span> te ayuda a trasladarte con confianza, seguimiento en tiempo real y atención personalizada para citas, oficinas, hospitales, trámites y viajes especiales.
                </p>
                <div class="mt-2.5 flex flex-wrap gap-2">
                    <span class="px-2.5 py-1 bg-white/5 border border-white/10 rounded-full text-[9px] lg:text-[10px] font-bold text-gray-200 uppercase tracking-widest flex items-center gap-1">
                        <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        Seguridad
                    </span>
                    <span class="px-2.5 py-1 bg-white/5 border border-white/10 rounded-full text-[9px] lg:text-[10px] font-bold text-gray-200 uppercase tracking-widest flex items-center gap-1">
                        <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        Puntualidad
                    </span>
                    <span class="px-2.5 py-1 bg-white/5 border border-white/10 rounded-full text-[9px] lg:text-[10px] font-bold text-gray-200 uppercase tracking-widest flex items-center gap-1">
                        <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                        Confort
                    </span>
                </div>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-3 pt-1">
                <button class="bg-white text-black px-6 py-2.5 rounded-full font-bold text-sm hover:shadow-[0_0_15px_rgba(255,255,255,0.4)] hover:-translate-y-0.5 transition-all duration-300">
                    Solicitar Traslado
                </button>
                <button class="group/btn flex items-center gap-2 bg-transparent text-white font-bold text-sm hover:opacity-80 transition-opacity">
                    <span>Programar Viaje</span>
                    <div class="w-8 h-8 rounded-full border-2 border-white flex items-center justify-center group-hover/btn:bg-white group-hover/btn:text-black transition-all">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </div>
                </button>
            </div>
        </div>
    </div>
</section>

